{
  // Cloudflare Workers static site. No server code: Cloudflare serves the files in ./public.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pewpewgame",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
